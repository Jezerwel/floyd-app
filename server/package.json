{
  "name": "floyd-feeder-server",
  "version": "1.0.0",
  "description": "Express API and MQTT scheduler for Floyd Fish Feeder",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push"
  },
  "keywords": [
    "express",
    "typescript",
    "fish-feeder",
    "iot",
    "mqtt"
  ],
  "author": "Floyd Feeder Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mqtt": "^5.15.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.0.2",
    "prisma": "^6.11.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
