# Floyd Feeder — Server Environment Variables
# Copy this file to server/.env and fill in the values.
# All variables are optional unless marked REQUIRED.

# REQUIRED — Prisma database connection string
# SQLite (local development):
DATABASE_URL=file:./prisma/floyd.db

# PostgreSQL (production / Railway):
# DATABASE_URL=postgresql://user:password@host:5432/floyd?schema=public

# Server port (default: 3001)
PORT=3001


# ── MQTT Broker ──────────────────────────────────────
#
# ── Option A: Public broker (zero setup, recommended) ──
#   Uses plain MQTT (mqtt://) on port 1883.
#   No credentials, no account needed.
#   The ESP8266 connects on plain TCP — no TLS overhead, reliable.
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883

# ── Option B: Dedicated HiveMQ Cloud cluster ──
#   TLS (mqtts://) is MANDATORY — HiveMQ Cloud only accepts TLS on port 8883.
#   Username + password required.
#   NOTE: If using this, the ESP8266 firmware must also be modified
#         to use WiFiClientSecure + enableSSL(true) + port 8883.
#         TLS on ESP8266 is known to be unreliable (OOM, handshake failures).
#         See docs/floyd-feeder-manual-setup.md for details.
# MQTT_BROKER_URL=mqtts://x1a2b3c4d5e6f7g8h9.s1.eu.hivemq.cloud:8883
# MQTT_USERNAME=floyd-server
# MQTT_PASSWORD=your-generated-password-here


# ── Optional ─────────────────────────────────────────

# Node environment
# NODE_ENV=production
