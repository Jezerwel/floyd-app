# Floyd Feeder — App Environment Variables
# Copy this file to .env (project root) and fill in the values.

# MQTT broker URL for the mobile app
# Uses TLS (mqtts://) by default — both public broker and dedicated cluster
# support MQTTS on port 8883.
#
# ── Option A: Public broker (zero setup, recommended) ──
#   The app always uses TLS (mqtts://) regardless of broker choice.
#   The ESP8266 and server use plain MQTT (mqtt://) for the public broker.
#   This is the most reliable setup — TLS is only on the app side (plenty of resources).
EXPO_PUBLIC_MQTT_BROKER_URL=mqtts://broker.hivemq.com:8883

# ── Option B: Dedicated HiveMQ Cloud cluster ──
#   TLS (mqtts://) is MANDATORY for dedicated clusters.
#   NOTE: Requires firmware changes to ESP8266 for TLS support.
# EXPO_PUBLIC_MQTT_BROKER_URL=mqtts://x1a2b3c4d5e6f7g8h9.s1.eu.hivemq.cloud:8883

# API server URL — used by services/api.ts for device claim and REST calls
# Change this to your deployed Railway URL.
# EXPO_PUBLIC_API_URL=https://your-app.up.railway.app
